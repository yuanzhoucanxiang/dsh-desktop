{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.44",
  "description": "DeepSeek Harness 桌面快捷启动外壳：拉起 dsh web 内核并用原生窗口承载，不修改内核。",
  "author": "dsh-desktop",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke",
    "prepare:runtime": "powershell -ExecutionPolicy Bypass -File prepare-runtime.ps1",
    "dist": "node plugin-selector-check.js && powershell -ExecutionPolicy Bypass -File build.ps1",
    "release": "powershell -ExecutionPolicy Bypass -File release.ps1",
    "ui-smoke": "electron . --ui-smoke",
    "splash-check": "electron splash-check.js",
    "splash-shot": "electron splash-shot.js",
    "splash-preview": "electron splash-preview.js",
    "git-review-test": "node lib/git-review.test.js",
    "profile-inspect-test": "node lib/profile-inspect.test.js",
    "atomic-file-test": "node lib/atomic-file.test.js",
    "selector-check": "node plugin-selector-check.js",
    "verify:kernel": "node scripts/verify-kernel-contract.mjs",
    "verify:render": "node scripts/verify-render-invariants.mjs",
    "verify:plugins": "node scripts/verify-plugin-compat.mjs",
    "verify:writing": "node scripts/verify-writing-mode.mjs",
    "verify:writing-ui": "electron scripts/verify-writing-ui.cjs",
    "verify:writing-chat": "electron scripts/verify-writing-chat.cjs",
    "verify:writing-native": "electron scripts/verify-writing-native.cjs",
    "build:writing": "node scripts/build-writing-client.mjs",
    "verify:writing-build": "node scripts/verify-writing-build.mjs",
    "test:writing-f": "node plugin/writing-mode/test/review-f01-f06.mjs",
    "test:writing-cde": "node plugin/writing-mode/test/architecture-cde.mjs",
    "test:writing-p1": "node plugin/writing-mode/test/p1-regression.mjs",
    "test:writing-world": "node plugin/writing-mode/test/world-settings-p1.mjs && node plugin/writing-mode/test/world-settings-context.mjs && node plugin/writing-mode/test/world-settings-p3.mjs && node plugin/writing-mode/test/hunt-host.mjs && node plugin/writing-mode/test/world-settings-repair.mjs && node plugin/writing-mode/test/draft-reliability.mjs && node plugin/writing-mode/test/create-project-http.mjs",
    "test:writing-hardening": "node plugin/writing-mode/test/hardening-v1-v9.mjs",
    "prestart": "npm run build:writing",
    "predev": "npm run build:writing",
    "verify:writing-architecture": "node scripts/verify-writing-architecture.mjs && node scripts/verify-writing-imports.mjs && node scripts/verify-writing-imports.selftest.mjs",
    "verify:writing-package": "node scripts/verify-writing-package.mjs && node scripts/verify-writing-coldstart.mjs",
    "plugin-sync-test": "node lib/plugin-sync.test.js",
    "verify:writing-all": "npm run verify:writing-architecture && npm run verify:writing-build && npm run verify:writing && npm run verify:writing-adapter && npm run verify:writing-memory-ui && npm run verify:writing-context && npm run verify:writing-package && npm run plugin-sync-test && npm run test:writing-f && npm run test:writing-cde && npm run test:writing-p1 && npm run verify:writing-ui && npm run verify:writing-navigation && npm run verify:writing-chat && npm run verify:writing-reading && npm run verify:writing-native && npm run verify:writing-review-probes && npm run verify:writing-baseline-ui && npm run test:writing-world && npm run test:writing-hardening && npm run test:writing-existing && npm run verify:writing-existing-ui && npm run verify:writing-world-ui && npm run verify:ui-smoke && npm run verify:writing-packaged",
    "test:writing-coordination": "node plugin/writing-mode/test/coordination.mjs",
    "test:writing-adapter": "node plugin/writing-mode/test/adapter-coordination.mjs",
    "test:writing-p3": "node plugin/writing-mode/test/p3-memory-context.mjs",
    "verify:writing-adapter": "node plugin/writing-mode/test/coordination.mjs && node plugin/writing-mode/test/adapter-coordination.mjs",
    "verify:writing-memory-ui": "node plugin/writing-mode/test/p3-memory-context.mjs --group=M",
    "verify:writing-context": "node plugin/writing-mode/test/p3-memory-context.mjs --group=C && node plugin/writing-mode/test/p3-memory-context.mjs --group=D",
    "verify:writing-packaged": "node scripts/verify-writing-packaged.mjs",
    "verify:ui-smoke": "node scripts/verify-ui-smoke.mjs",
    "verify:writing-review-probes": "node docs/audits/writing-architecture/2026-09-14/v2-review/probes.mjs && node scripts/run-review-ui-probes.mjs",
    "verify:writing-baseline-ui": "node scripts/run-baseline-ui.mjs",
    "verify:writing-packaged-dev": "node scripts/verify-writing-packaged.mjs --allow-missing",
    "verify:writing-quick": "npm run verify:writing-architecture && npm run verify:writing-build && npm run verify:writing && npm run verify:writing-adapter && npm run verify:writing-memory-ui && npm run verify:writing-context && npm run verify:writing-package && npm run plugin-sync-test && npm run test:writing-f && npm run test:writing-cde && npm run test:writing-p1 && npm run verify:writing-ui && npm run verify:writing-navigation && npm run verify:writing-chat && npm run verify:writing-reading && npm run verify:writing-native && npm run verify:writing-review-probes && npm run verify:writing-baseline-ui && npm run test:writing-world && npm run test:writing-hardening && npm run test:writing-existing && npm run verify:writing-existing-ui && npm run verify:writing-world-ui && npm run verify:ui-smoke",
    "pid-cleanup-test": "node lib/pid-cleanup.test.js",
    "shell-hardening-test": "node lib/shell-hardening.test.js",
    "hotkey-test": "node lib/hotkey.test.js",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.mjs",
    "plugin-manager-test": "node lib/plugin-manager.test.js",
    "verify:writing-reading": "electron scripts/verify-writing-reading.cjs",
    "verify:writing-world-ui": "electron scripts/verify-writing-world-ui.cjs && electron docs/audits/writing-world-settings/2026-09-22/repair-integrated-ui.cjs",
    "test:writing-existing": "node plugin/writing-mode/test/existing-project.mjs",
    "verify:writing-existing-ui": "electron scripts/verify-existing-project-ui.cjs",
    "verify:writing-navigation": "electron scripts/verify-writing-navigation.cjs",
    "app-icon-test": "node lib/app-icon.test.js"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.deepseek.dshdesktop",
    "productName": "DeepSeek Harness Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/*.png",
      "build/icons/*",
      "build/icon.ico",
      "build/whale-source.svg",
      "package.json",
      "lib/*.js",
      "!lib/*.test.js"
    ],
    "extraResources": [
      {
        "from": "dist/runtime.tar.gz",
        "to": "runtime.tar.gz"
      },
      {
        "from": "dist/runtime-marker.json",
        "to": "runtime-marker.json"
      },
      {
        "from": "plugin",
        "to": "plugin",
        "filter": [
          "review-bridge.js",
          "review-bridge.patch.yml"
        ]
      },
      {
        "from": "plugin/dialog-optimize",
        "to": "plugin/dialog-optimize",
        "filter": [
          "package.json",
          "index.js",
          "client.js"
        ]
      },
      {
        "from": "plugin/shell-settings",
        "to": "plugin/shell-settings",
        "filter": [
          "package.json",
          "index.js",
          "client.js"
        ]
      },
      {
        "from": "plugin/writing-mode",
        "to": "plugin/writing-mode",
        "filter": [
          "package.json",
          "index.js",
          "client.js",
          "runtime-manifest.json",
          "CONTRACT.md",
          "lib/*",
          "!lib/editor-session.js"
        ]
      },
      {
        "from": "dist/builtin-plugins",
        "to": "builtin-plugins"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "yuanzhoucanxiang",
      "repo": "dsh-desktop"
    },
    "artifactName": "dsh-desktop-${version}-setup.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon-512.png",
      "artifactName": "dsh-desktop-${version}-mac.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness"
    }
  }
}

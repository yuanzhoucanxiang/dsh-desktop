{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.2",
  "description": "DeepSeek Harness 妗岄潰蹇嵎鍚姩澶栧３锛氭媺璧?dsh web 鍐呮牳骞剁敤鍘熺敓绐楀彛鎵胯浇锛屼笉淇敼鍐呮牳銆?,
  "author": "dsh-desktop",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke",
    "prepare:runtime": "powershell -ExecutionPolicy Bypass -File prepare-runtime.ps1",
    "dist": "powershell -ExecutionPolicy Bypass -File build.ps1",
    "release": "powershell -ExecutionPolicy Bypass -File release.ps1"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.deepseek.dshdesktop",
    "productName": "DeepSeek Harness Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/*.png",
      "build/icon.ico",
      "build/whale-source.svg",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "plugin",
        "to": "plugin",
        "filter": [
          "review-bridge.js",
          "review-bridge.patch.yml"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "yuanzhoucanxiang",
      "repo": "dsh-desktop"
    },
    "artifactName": "dsh-desktop-${version}-setup.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon-512.png",
      "artifactName": "dsh-desktop-${version}-mac.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness"
    }
  }
}


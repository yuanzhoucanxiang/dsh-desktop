{
  "name": "@dsh-local/shell-settings",
  "version": "1.0.0",
  "private": true,
  "description": "桌面外壳桥：在内核设置的插件分区贡献「桌面外壳」标签页（插件体检 / 软件更新入口）",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}

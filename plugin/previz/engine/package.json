{
  "name": "blender-previz",
  "version": "0.1.0",
  "private": true,
  "description": "Blender 白模预演引擎（schema / builder / render / QC / CLI / Node API）",
  "type": "module",
  "main": "lib/pipeline.mjs",
  "exports": {
    ".": "./lib/pipeline.mjs"
  },
  "bin": {
    "previz": "scripts/previz.mjs"
  },
  "scripts": {
    "previz": "node scripts/previz.mjs",
    "validate": "node scripts/previz.mjs validate fixtures/boutique",
    "build:scene": "node scripts/previz.mjs build fixtures/boutique --out demo-out",
    "render:scene": "node scripts/previz.mjs render fixtures/boutique --out demo-out",
    "encode": "node scripts/previz.mjs encode demo-out",
    "qc": "node scripts/previz.mjs qc demo-out",
    "burnin": "node scripts/previz.mjs burn-in demo-out",
    "export": "node scripts/previz.mjs export demo-out",
    "import": "node scripts/previz.mjs import fixtures/boutique/storyboard.csv",
    "script": "node scripts/previz.mjs script fixtures/boutique/script.txt",
    "board": "node scripts/previz.mjs board fixtures/boutique/script.txt",
    "panels": "node scripts/previz.mjs panels fixtures/boutique",
    "projects": "node scripts/previz.mjs projects",
    "demo": "node scripts/previz.mjs demo fixtures/boutique --out demo-out",
    "demo:burnin": "node scripts/previz.mjs demo fixtures/boutique --out demo-out --burn-in",
    "demo:force": "node scripts/previz.mjs demo fixtures/boutique --out demo-out --force",
    "acceptance": "node scripts/acceptance.mjs",
    "acceptance:quick": "node scripts/acceptance.mjs --quick",
    "test": "node --test test/framing.test.mjs test/validate.test.mjs test/qc.test.mjs test/pipeline.test.mjs test/cli.test.mjs test/export.test.mjs test/storyboard.test.mjs test/projects.test.mjs test/script.test.mjs test/panels.test.mjs test/scenes.test.mjs test/multiscene.test.mjs test/panels-csv.test.mjs test/camera-feel.test.mjs test/camera-response.test.mjs test/camera-layering.test.mjs test/shutter.test.mjs test/calibration.test.mjs test/preset-matrix.test.mjs test/feel-presets.test.mjs test/jitter-amplitude.test.mjs test/spec-gate.test.mjs",
    "calibrate": "node scripts/calibrate.mjs",
    "check:feel": "node scripts/check-feel-presets.mjs",
    "spec:gate": "node scripts/spec-gate.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}

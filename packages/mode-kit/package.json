  "exports": {
    ".": "./src/index.js",
    "./harness/adapter.js": "./src/harness/adapter.js",
    "./harness/projection.js": "./src/harness/projection.js",
    "./harness/identity.js": "./src/harness/identity.js",
    "./harness/coordination-client.js": "./src/harness/coordination-client.js",
    "./package.json": "./package.json"
  }
}
